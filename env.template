# Elastic Cloud Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it's in .gitignore)

# --- Gawdzilla (single-cluster default for this demo) ---
# Elasticsearch Instance (ES endpoint)
ELASTIC_ES_URL=https://gawdzilla-0d3e9e.es.us-east-2.aws.elastic-cloud.com:443

# Kibana Instance (Agent Builder — scholarship agents use ELASTIC_KB_URL + ELASTIC_API_KEY)
ELASTIC_KB_URL=https://gawdzilla-0d3e9e.kb.us-east-2.aws.elastic-cloud.com

# API key for Gawdzilla ES + Kibana (NEVER commit this to git)
# Set ELASTIC_API_KEY and OK_KIBANA_API_KEY to the SAME Gawdzilla key (not a legacy Apex key).
ELASTIC_API_KEY=

# Optional: Agent ID for Agent Builder
# Overrides elastic.agentId on EVERY template (see js/config/templateEngine.js).
# Leave unset for Oklahoma Agency (?template=okagency) so chat uses okagency.js elastic.agentId (ok-grants-data).
ELASTIC_AGENT_ID=

# Gawdzilla Kibana (ok-fraud, ok-grants-data, booster-donor-data, gameday-revenue-data, ou-met-* agents) — same deployment as ELASTIC_KB_URL by default
OK_KIBANA_URL=https://gawdzilla-0d3e9e.kb.us-east-2.aws.elastic-cloud.com
OK_KIBANA_API_KEY=

# Optional: explicit Gawdzilla ES URL (defaults to same host as ELASTIC_ES_URL)
# OK_ELASTIC_ES_URL=https://gawdzilla-0d3e9e.es.us-east-2.aws.elastic-cloud.com:443

# --- Legacy Apex (only needed to run scripts/migrate-apex-to-gawdzilla/migrate.py) ---
# APEX_ELASTIC_ES_URL=https://apex-dec2025-group4-b01431.es.us-central1.gcp.elastic.cloud:443
# APEX_ELASTIC_API_KEY=

# Optional: Template ID (texas, oklahoma, default)
# Can also be set via URL parameter ?template=texas or subdomain
TEMPLATE_ID=

# Optional: Kibana URL for ok-* dashboards (e.g. Mental Health Fraud dashboard)
# Used when template=okmentalhealth to link to Kibana dashboards whose titles start with "ok-"
# OK_KIBANA_URL=

# --- Agent Builder setup (run after .env keys are set) ---
# One-shot provision all template agents, tools, and workflows:
#   bash scripts/setup_all_agents.sh
#
# Prerequisite for scholarship agents: shared tools from Apex migration (once):
#   python3 scripts/migrate-apex-to-gawdzilla/migrate.py --agents-only
#
# Template → Agent ID map:
#   default          → scholarship-counselor-default
#   texas            → texas-scholarship-counselor
#   oklahoma         → oklahoma-scholarship-counselor
#   beauregard       → beauregard-scholarship-counselor
#   dot              → dot-transportation-assistant
#   okagency         → ok-grants-data
#   okmentalhealth   → ok-grants-data (public), ok-fraud (staff)
#   texascollege     → booster-donor-data, gameday-revenue-data
#   okstate          → okstate-donor-assistant, okstate-gameday-revenue-assistant
#                    (giving rules: python3 scripts/okstate/ingest_giving_policies.py && python3 scripts/okstate/setup_giving_agent.py)
#   okoja            → ok-oja-data
#   oumet            → ou-met-catalog-agent, ou-met-provisioning-agent
#   wyoming          → wyo-classify (python3 scripts/wyoming/setup_agent.py)
#                      Load corpus from data-classification-tool; see scripts/wyoming/README.md

# --- OU Met JupyterLite (optional) ---
# JUPYTERLITE_URL=https://jupyterlite.github.io/demo/lab/index.html
# NOTEBOOK_GENERATOR_PUBLIC_URL=http://localhost:8765
# Start generator: uvicorn services.notebook_generator.app:app --port 8765
# College demo dev proxy: /api/notebook-generator → localhost:8765

# --- Oklahoma Agency / Agent Builder HTTP 500 ---
# 1) Browser DevTools → Network → failed POST .../api/elastic/agent/.../chat → read response body.
# 2) In Kibana: Stack Management → Agent Builder → confirm agent ID matches template elastic.agentId.
# 3) Ensure OK_KIBANA_API_KEY can call Agent Builder on Gawdzilla.

# Elastic APM Configuration (for browser tracing)
ELASTIC_APM_SERVER_URL=
ELASTIC_APM_API_KEY=
# ELASTIC_APM_SECRET_TOKEN=
# ELASTIC_APM_SERVICE_NAME=

# Elastic Agent Configuration (for logs and metrics)
ELASTIC_AGENT_API_KEY=
# ELASTIC_AGENT_ES_URL=
