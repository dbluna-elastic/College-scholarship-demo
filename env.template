# Elastic Cloud Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it's in .gitignore)

# Elasticsearch Instance (ES endpoint)
ELASTIC_ES_URL=https://apex-dec2025-group4-b01431.es.us-central1.gcp.elastic.cloud:443

# Kibana Instance (Agent Builder endpoint)
ELASTIC_KB_URL=https://apex-dec2025-group4-b01431.kb.us-central1.gcp.elastic.cloud

# Elastic API Key (NEVER commit this to git)
# Get this from your Elastic Cloud dashboard
ELASTIC_API_KEY=

# Optional: Agent ID for Agent Builder
# Overrides elastic.agentId on EVERY template (see js/config/templateEngine.js).
# Leave unset for Oklahoma Agency (?template=okagency) so chat uses okagency.js elastic.agentId (ok-grants-data).
# If set, chat may hit a different nginx route (gawdzilla vs apex) and a different API key than you expect.
ELASTIC_AGENT_ID=

# Optional: Template ID (texas, oklahoma, default)
# Can also be set via URL parameter ?template=texas or subdomain
TEMPLATE_ID=

# Optional: Kibana URL for ok-* dashboards (e.g. Mental Health Fraud dashboard)
# Used when template=okmentalhealth to link to Kibana dashboards whose titles start with "ok-"
# If not set, the okmentalhealth template uses its default gawdzilla Kibana URL.
# OK_KIBANA_URL=

# API key for gawdzilla / ok-fraud agent (NEVER commit to git)
# Required for the Mental Health Fraud dashboard (ok-fraud) and Oklahoma Agency Agent Builder (ok-grants-data).
# Create this in the gawdzilla Kibana deployment (Elastic Cloud → gawdzilla → Stack Management → API Keys).
# OK_KIBANA_API_KEY=

# Optional: Elasticsearch URL for gawdzilla (ok-fraud ESQL, e.g. ok-fraud-phantom-billing index).
# Default is derived from OK_KIBANA_URL (same deployment, .kb. → .es.). Set if your ES endpoint differs.
# OK_ELASTIC_ES_URL=

# --- Oklahoma Agency / Agent Builder HTTP 500 ---
# 1) Browser DevTools → Network → failed POST .../api/elastic/agent/.../chat → read response body (Kibana often returns JSON with error.reason).
# 2) In Kibana on the SAME deployment as OK_KIBANA_URL: Stack Management → Agent Builder → confirm the agent ID matches js/config/templates/okagency.js elastic.agentId (default ok-grants-data).
# 3) Ensure OK_KIBANA_API_KEY can call Agent Builder on that Kibana (create key in that deployment).
# 4) If the agent exists only on ELASTIC_KB_URL (apex), not gawdzilla: remove ok-grants-data from the gawdzilla-only
#    agent chat block in nginx.conf, remove the ok-grants-data vite proxy entry, remove ok-grants-data from
#    GAWDZILLA_AGENT_BUILDER_IDS in js/modules/utils/elasticApi.js, and use ELASTIC_API_KEY for chat.

# Elastic APM Configuration (for browser tracing)
# APM Server URL - Get this from your Elastic Cloud deployment
# Format: https://your-deployment.apm.us-central1.gcp.elastic.cloud:443
ELASTIC_APM_SERVER_URL=

# Elastic APM Authentication (choose one)
# Option 1: API Key (recommended)
ELASTIC_APM_API_KEY=
# Option 2: Secret Token (alternative to API key)
# ELASTIC_APM_SECRET_TOKEN=

# Optional: Override service name (defaults to template institution name)
ELASTIC_APM_SERVICE_NAME=

# Elastic Agent Configuration (for logs and metrics)
# Elastic Agent API Key (NEVER commit this to git)
# Required for Elastic Agent to authenticate and send logs/metrics to Elastic Stack
# If not set, Elastic Agent will not start
ELASTIC_AGENT_API_KEY=

# Optional: Elasticsearch URL for Elastic Agent (defaults to ELASTIC_ES_URL)
# ELASTIC_AGENT_ES_URL=
