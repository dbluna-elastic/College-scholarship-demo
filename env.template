# Elastic Cloud Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it's in .gitignore)

# Elasticsearch Instance (ES endpoint)
ELASTIC_ES_URL=https://apex-dec2025-group4-b01431.es.us-central1.gcp.elastic.cloud

# Kibana Instance (Agent Builder endpoint)
ELASTIC_KB_URL=https://apex-dec2025-group4-b01431.kb.us-central1.gcp.elastic.cloud

# Elastic API Key (NEVER commit this to git)
# Get this from your Elastic Cloud dashboard
ELASTIC_API_KEY=

# Optional: Agent ID for Agent Builder
ELASTIC_AGENT_ID=

# Optional: Template ID (texas, oklahoma, default)
# Can also be set via URL parameter ?template=texas or subdomain
TEMPLATE_ID=

# OpenTelemetry Collector Configuration
# OTLP endpoint for sending telemetry data (metrics, logs, traces)
ELASTIC_OTLP_ENDPOINT=https://gawdzilla-0d3e9e.ingest.us-east-2.aws.elastic-cloud.com:443

# OpenTelemetry Collector API Key (NEVER commit this to git)
# Required for OpenTelemetry Collector to authenticate and send data to Elastic Stack
# If not set, OpenTelemetry Collector will not start
ELASTIC_OTLP_API_KEY=
